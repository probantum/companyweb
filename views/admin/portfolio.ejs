<!doctype html>
<html lang="en">
<head>
<%- include('../partials/admin-head', { title: 'Portfolio' }) %>
<style>
  .image-drop {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .image-drop input[type='file'] {
    flex: 1;
  }
  .image-drop__preview {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    object-fit: cover;
    border: 1px solid var(--border-strong);
    display: none;
  }
  .image-drop__preview.is-visible {
    display: block;
  }
  .gallery-manager {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .gallery-manager__item {
    position: relative;
    width: 64px;
    height: 64px;
  }
  .gallery-manager__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-strong);
    display: block;
  }
  .gallery-manager__item.is-marked img {
    opacity: 0.3;
  }
  .gallery-manager__remove {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--text);
    color: var(--surface);
    border: none;
    font-size: 11px;
    line-height: 18px;
    cursor: pointer;
    padding: 0;
  }
</style>
</head>
<body>
<div class="admin">
  <%- include('../partials/admin-nav', { active }) %>
  <div class="admin__main">
    <div class="admin__header">
      <div>
        <h2 class="admin__title">Portfolio</h2>
        <p class="admin__subtitle">Case studies shown on the public portfolio page.</p>
      </div>
      <div class="admin__header-actions">
        <button type="button" class="btn btn-primary btn-icon-add" id="portfolioAddBtn" style="font-size: 13px; padding: 10px 18px">New item</button>
        <form method="POST" action="/admin/logout">
          <button type="submit" class="admin__logout">Log out</button>
        </form>
      </div>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Tags</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% portfolio.forEach((item) => { %>
            <tr>
              <td>
                <div class="name-cell">
                  <% if (item.image) { %>
                    <img src="<%= item.image %>" alt="" style="width: 36px; height: 36px; border-radius: var(--radius-md); object-fit: cover; flex-shrink: 0" />
                  <% } %>
                  <span class="row-primary"><%= item.name %></span>
                </div>
              </td>
              <td style="color: var(--text-muted); max-width: 320px"><%= item.desc %></td>
              <td style="color: var(--text-muted)"><%= (item.tags || []).join(', ') %></td>
              <td>
                <div class="admin-actions">
                  <button
                    type="button"
                    class="icon-btn icon-btn--edit"
                    title="Edit"
                    data-edit-trigger="portfolio"
                    data-action="/admin/portfolio/<%= item.id %>"
                    data-record="<%= JSON.stringify(item) %>"
                  ><%- icons.edit %></button>
                  <a href="/portfolio/<%= item.id %>" class="icon-btn icon-btn--view" title="View on site" target="_blank"><%- icons.eye %></a>
                  <form method="POST" action="/admin/portfolio/<%= item.id %>/delete" onsubmit="return confirm('Delete this item?')">
                    <button type="submit" class="icon-btn icon-btn--danger" title="Delete"><%- icons.trash %></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
          <% if (!portfolio.length) { %>
            <tr><td colspan="4" class="admin-table-empty">No portfolio items yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="modal-overlay" id="portfolioModal">
  <div class="modal">
    <div class="modal-header">
      <h3 id="portfolioModalTitle">New item</h3>
      <button type="button" class="modal-close" data-modal-dismiss aria-label="Close"><%- icons.close %></button>
    </div>
    <form class="admin-form" id="portfolioForm" method="POST" enctype="multipart/form-data" data-create-action="/admin/portfolio">
      <div>
        <label>Name</label>
        <input required name="name" />
      </div>
      <div>
        <label>Description</label>
        <input required name="desc" />
      </div>
      <div class="grid-2">
        <div>
          <label>Tags (comma-separated)</label>
          <input name="tags" />
        </div>
        <div>
          <label>Primary tag (badge on home teaser)</label>
          <input name="tag" />
        </div>
      </div>
      <div>
        <label>Case study image (feature image)</label>
        <div class="image-drop">
          <img id="portfolioImagePreview" class="image-drop__preview" alt="" />
          <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif" id="portfolioImageInput" />
        </div>
      </div>
      <div>
        <label>Additional gallery images</label>
        <div class="gallery-manager" id="portfolioGalleryExisting"></div>
        <input type="file" name="gallery" accept="image/png,image/jpeg,image/webp,image/gif" id="portfolioGalleryInput" multiple style="margin-top: 10px" />
      </div>
      <div class="admin-form-actions">
        <button type="submit" class="btn btn-primary" style="font-size: 13px; padding: 10px 20px"><span id="portfolioSubmitLabel">Create</span></button>
        <button type="button" class="btn btn-secondary" style="font-size: 13px; padding: 10px 20px" data-modal-dismiss>Cancel</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/admin.js"></script>
<script>
  const portfolioImagePreview = document.getElementById('portfolioImagePreview');
  const portfolioImageInput = document.getElementById('portfolioImageInput');
  const portfolioGalleryExisting = document.getElementById('portfolioGalleryExisting');

  portfolioImageInput.addEventListener('change', () => {
    const file = portfolioImageInput.files[0];
    if (!file) return;
    portfolioImagePreview.src = URL.createObjectURL(file);
    portfolioImagePreview.classList.add('is-visible');
  });

  function renderGalleryThumbs(urls) {
    portfolioGalleryExisting.innerHTML = '';
    (urls || []).forEach((url) => {
      const item = document.createElement('div');
      item.className = 'gallery-manager__item';

      const img = document.createElement('img');
      img.src = url;
      item.appendChild(img);

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'gallery-manager__remove';
      removeBtn.textContent = '×';
      removeBtn.addEventListener('click', () => {
        const marked = item.classList.toggle('is-marked');
        const existingInput = item.querySelector('input[name="removeGallery"]');
        if (marked) {
          if (!existingInput) {
            const hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'removeGallery';
            hidden.value = url;
            item.appendChild(hidden);
          }
        } else if (existingInput) {
          existingInput.remove();
        }
      });
      item.appendChild(removeBtn);

      portfolioGalleryExisting.appendChild(item);
    });
  }

  setupCrudModal({
    overlayId: 'portfolioModal',
    formId: 'portfolioForm',
    titleId: 'portfolioModalTitle',
    submitLabelId: 'portfolioSubmitLabel',
    addButtonId: 'portfolioAddBtn',
    editGroup: 'portfolio',
    addTitle: 'New item',
    addSubmitLabel: 'Create item',
    editTitle: 'Edit item',
    editSubmitLabel: 'Save changes',
    onReset: () => {
      portfolioImagePreview.classList.remove('is-visible');
      portfolioImagePreview.src = '';
      renderGalleryThumbs([]);
    },
    onPopulate: (record) => {
      if (record.image) {
        portfolioImagePreview.src = record.image;
        portfolioImagePreview.classList.add('is-visible');
      } else {
        portfolioImagePreview.classList.remove('is-visible');
        portfolioImagePreview.src = '';
      }
      renderGalleryThumbs(record.gallery);
    },
  });
</script>
</body>
</html>
