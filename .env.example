PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Set to "production" when deploying behind HTTPS (nginx, Render, Railway, ...).
# See DEPLOY.md — required for session cookies to work correctly in production.
NODE_ENV=development

# Default admin login (username: admin / password: admin123)
# Generate a new hash with: node scripts/hash-password.js "your-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$OhbV/HvZGOjCL/1KNE0TqOnWOTX1TWkNQaa.kgr1.bYd5wPiOFTge

# MySQL — create the database and run sql/schema.sql against it first.
DB_HOST=localhost
DB_PORT=3306
DB_USER=probantum
DB_PASSWORD=change-this
DB_NAME=probantum

# SMTP — used to email the addresses configured in Admin > Settings whenever
# someone submits the public contact form. Leave SMTP_HOST unset to disable
# notification emails (the contact form still works, it just won't send mail).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
